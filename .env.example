# Backend Contact Form Email Configuration (Copy to .env.local and fill in GMAIL_APP_PASSWORD)
# Never commit .env.local or expose private credentials in source code.

# Destination inbox where all portfolio messages are delivered
CONTACT_RECEIVER_EMAIL=santhosha382007@gmail.com

# Gmail SMTP credentials (Create a 16-character App Password at https://myaccount.google.com/apppasswords)
GMAIL_USER=santhosha382007@gmail.com
GMAIL_APP_PASSWORD=your_16_char_gmail_app_password

# Optional: Custom SMTP overrides (defaults to Gmail SSL on port 465)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true

# Optional: Local backend API port (Vite proxies /api to http://127.0.0.1:3004)
API_PORT=3004

# Optional: If hosting the backend separately from the frontend, set the backend base URL
# VITE_API_BASE_URL=https://your-backend-domain.com

# Optional: Custom public site URL for metadata / sitemap updates
VITE_SITE_URL=https://aathiaa.dev
