{
  "name": "aathiaa-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AATHIAA — Personal Portfolio Website for Santhosh A. (Cyber Security | Software Engineering | AI Innovation)",
  "scripts": {
    "start": "concurrently -k -n web,api -c cyan,yellow \"vite --port 3003 --host localhost\" \"node server/index.mjs\"",
    "dev": "concurrently -k -n web,api -c cyan,yellow \"vite --port 3003 --host localhost\" \"node server/index.mjs\"",
    "dev:web": "vite --port 3003 --host localhost",
    "dev:api": "node server/index.mjs",
    "server": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 3003 --host localhost",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@tsparticles/engine": "^3.9.1",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.9.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "framer-motion": "^12.6.0",
    "lucide-react": "^0.511.0",
    "nodemailer": "^10.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.2"
  }
}
